BACKEND_PORT=4000
BACKEND_HOST=backend
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flaque <no-reply@example.com>
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX=10
AUTH_FORGOT_PASSWORD_MIN_RESPONSE_MS=300
AUTH_AUDIT_LOGS=true
HTTP_REQUEST_TIMEOUT_MS=0
HTTP_SOCKET_TIMEOUT_MS=0
DATA_ROOT=../data

# Logging
LOG_FILE=
LOG_ROTATION_FREQUENCY=daily
LOG_ROTATION_MAX_FILES=14
LOG_ROTATION_MAX_SIZE=

# Update checks
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_HOURS=6

# Self-update (set UPDATE_SECRET to enable the "Update now" button)
UPDATE_SECRET=
UPDATER_URL=http://updater:9090
